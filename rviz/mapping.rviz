Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Base1
        - /Degeneracy Perturbation Debug1
        - /Additional Odometry1
      Splitter Ratio: 0.39970502257347107
    Tree Height: 903
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
